@model EduGameMVC.Models.GameState

@{
    ViewData["Title"] = "Battle";
}

<div class="battle-page">
    <h1 class="battle-title">Battle Arena</h1>

    <section class="battle-scene" aria-label="Battle scene">
        <div class="battle-status">
            <div class="battle-status-card">
                <h2>Player</h2>
                <p>Health: @Model.PlayerHealth / 100</p>

                <div class="progress"
                     role="progressbar"
                     aria-label="Player health"
                     aria-valuenow="@Model.PlayerHealth"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    <div id="playerHealthBar"
                         class="progress-bar bg-success"
                         style="width: @(Model.PreviousPlayerHealth)%"
                         data-target="@Model.PlayerHealth">
                    </div>
                </div>

                <p class="special-points">Special Points: @Model.SpecialPoints</p>
            </div>

            <div class="battle-status-card enemy-status">
                <h2>Monster</h2>
                <p>Health: @Model.EnemyHealth / 100</p>

                <div class="progress"
                     role="progressbar"
                     aria-label="Monster health"
                     aria-valuenow="@Model.EnemyHealth"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    <div id="enemyHealthBar"
                         class="progress-bar bg-danger"
                         style="width: @(Model.PreviousEnemyHealth)%"
                         data-target="@Model.EnemyHealth">
                    </div>
                </div>
            </div>
        </div>

        <img class="battle-character player-character"
             src="~/images/game/Player.png"
             alt="Player character" />

        <img class="battle-character monster-character"
             src="~/images/game/Enemy1.png"
             alt="Monster" />
    </section>

    <section class="battle-controls">
        <p id="battleMessage" class="battle-message" aria-live="polite">
            @Model.BattleMessage
        </p>

        @if (Model.GameOver)
        {
            if (Model.EnemyHealth <= 0)
            {
                <h2 class="text-success">Victory!</h2>
            }
            else
            {
                <h2 class="text-danger">Defeat!</h2>
            }

            <form asp-action="Restart" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">
                    Restart Battle
                </button>
            </form>
        }
        else if (!Model.EnemyTurnPending && !Model.EnemyAttackPending)
        {
            <form asp-action="Attack" method="post" class="battle-actions">
                @Html.AntiForgeryToken()

                <button type="submit"
                        name="attackType"
                        value="Light"
                        class="btn btn-primary">
                    Light Attack
                </button>

                <button type="submit"
                        name="attackType"
                        value="Heavy"
                        class="btn btn-danger"
                        disabled="@(Model.SpecialPoints < 3)">
                    Heavy Attack (3 SP)
                </button>
            </form>
        }
        else
        {
            <p>Please wait for the monster's turn to finish...</p>
        }
    </section>
</div>

@if (!Model.GameOver)
{
    <form id="enemyTurnForm" asp-action="EnemyTurn" method="post" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <form id="resolveEnemyForm" asp-action="ResolveEnemyAttack" method="post" class="d-none">
        @Html.AntiForgeryToken()
    </form>
}

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const playerBar = document.getElementById("playerHealthBar");
        const enemyBar = document.getElementById("enemyHealthBar");

        function animateHealthBar(bar) {
            if (!bar) return Promise.resolve();

            const target = Number(bar.dataset.target);
            bar.style.transition = "width 900ms linear";

            return new Promise(resolve => {
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        bar.style.width = `${target}%`;
                    });
                });

                window.setTimeout(resolve, 950);
            });
        }

        async function runBattleSequence() {
            await animateHealthBar(enemyBar);

            const enemyTurnForm = document.getElementById("enemyTurnForm");
            const resolveEnemyForm = document.getElementById("resolveEnemyForm");

            if (enemyTurnForm) {
                enemyTurnForm.requestSubmit();
                return;
            }

            if (resolveEnemyForm) {
                resolveEnemyForm.requestSubmit();
            }
        }

        const enemyTurnPending = @Model.EnemyTurnPending.ToString().ToLower();
        const enemyAttackPending = @Model.EnemyAttackPending.ToString().ToLower();

        if (enemyAttackPending) {
            window.setTimeout(() => {
                document.getElementById("resolveEnemyForm")?.requestSubmit();
            }, 1000);
        } else if (enemyTurnPending) {
            runBattleSequence();
        } else {
            animateHealthBar(playerBar);
        }
    });
</script>