@model EduGameMVC.Models.Question

@{
    ViewData["Title"] = "Question Details";
}

<h1>Question Details</h1>

<div class="card">
    <div class="card-body">

        <h4>@Model.QuestionText</h4>

        <hr />

        <p><strong>A:</strong> @Model.OptionA</p>
        <p><strong>B:</strong> @Model.OptionB</p>
        <p><strong>C:</strong> @Model.OptionC</p>
        <p><strong>D:</strong> @Model.OptionD</p>

        <p>
            <strong>Correct answer:</strong>
            @Model.CorrectOption
        </p>

        <p>
            <strong>Subject:</strong>
            @Model.Subject
        </p>

        <p>
            <strong>Difficulty:</strong>
            @Model.Difficulty
        </p>

    </div>
</div>

<div class="mt-3">

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</div>