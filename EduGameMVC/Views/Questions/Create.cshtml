@model EduGameMVC.Models.Question

@{
    ViewData["Title"] = "Create Question";
}

<h1>Create Question</h1>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="QuestionText" class="form-label"></label>
        <input asp-for="QuestionText" class="form-control" />
        <span asp-validation-for="QuestionText"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="OptionA" class="form-label"></label>
        <input asp-for="OptionA" class="form-control" />
        <span asp-validation-for="OptionA"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="OptionB" class="form-label"></label>
        <input asp-for="OptionB" class="form-control" />
        <span asp-validation-for="OptionB"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="OptionC" class="form-label"></label>
        <input asp-for="OptionC" class="form-control" />
        <span asp-validation-for="OptionC"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="OptionD" class="form-label"></label>
        <input asp-for="OptionD" class="form-control" />
        <span asp-validation-for="OptionD"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CorrectOption" class="form-label"></label>
        <input asp-for="CorrectOption" class="form-control" />
        <span asp-validation-for="CorrectOption"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Subject" class="form-label"></label>
        <input asp-for="Subject" class="form-control" />
        <span asp-validation-for="Subject"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Difficulty" class="form-label"></label>
        <input asp-for="Difficulty" class="form-control" />
        <span asp-validation-for="Difficulty"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Create
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}